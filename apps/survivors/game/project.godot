; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="大厂幸存者"
config/description="大厂幸存者 —— 割草类 roguelike：躲开 Bug、会议和 Deadline，撑过 10 分钟就能敲钟上市。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.862745, 0.937255, 0.776471, 1)
boot_splash/image="res://assets/splash.png"
config/icon="res://assets/art/coder.svg"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[importer_defaults]

texture={
"mipmaps/generate": true,
"svg/scale": 4.0
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.862745, 0.937255, 0.776471, 1)

[internationalization]

locale/fallback="zh"
