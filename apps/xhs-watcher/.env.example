# ── 订阅 ────────────────────────────────────────────────────────────────────
# 首次启动时用来生成 $DATA_DIR/watches.json；之后改 watches.json 即可（更灵活：
# 可按关键词单独设置排序、最低点赞数、启用状态）。
KEYWORDS=露营装备,城市漫步

# ── 调度 ────────────────────────────────────────────────────────────────────
CRON=*/45 * * * *
TZ=Asia/Shanghai
RUN_ON_START=true


# ── 抓取行为 ────────────────────────────────────────────────────────────────
HEADLESS=true
SCROLLS=0              # 每个关键词额外下拉次数；0 = 只取首屏约 20 条
DELAY_MIN_MS=3000      # 关键词之间的随机间隔
DELAY_MAX_MS=8000

# ── 去重 / 过滤 ─────────────────────────────────────────────────────────────
SEED_ON_FIRST_RUN=true # 首轮只建立基线，不推送历史内容
MAX_AGE_DAYS=7         # 已知发布时间超过该天数的笔记不进摘要

# ── 失败处理 ────────────────────────────────────────────────────────────────
ALERT_COOLDOWN_HOURS=6
BACKOFF_AFTER_FAILURES=3
BACKOFF_HOURS=6

# ── 本地开发 ────────────────────────────────────────────────────────────────
DATA_DIR=./data
