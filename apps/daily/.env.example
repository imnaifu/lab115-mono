# Copy to .env and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#
# `npm run once` and `npm run dev` both load .env automatically, so no secrets
# need to appear on the command line (or in your shell history).
#
# In production none of this file is used: Coolify supplies the same variables
# to the container via docker-compose.yml.

# Required — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Push credentials. Leave BOTH empty on a laptop that already has a GitHub SSH
# key loaded: the remote then defaults to git@github.com:<GIT_REPO>.git.
# Set GIT_TOKEN (fine-grained PAT, contents:write) to push over HTTPS instead —
# that is what the container does, since it has no SSH key.
GIT_TOKEN=
# Overrides the remote URL entirely, if you need something other than the two
# routes above.
GIT_REMOTE=

# Optional — https://api.day.app/<your-key>
BARK_URL=

# Optional overrides; see README.md for the full list and defaults.
# GIT_REPO=imnaifu/files
# DAILY_TOP_N=10
# DAILY_WINDOW_HOURS=24
# DRY_RUN=1
