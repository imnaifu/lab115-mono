# Copy to .env and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#
# `npm run once` and `npm run dev` both load .env automatically, so no secrets
# need to appear on the command line (or in your shell history).
#
# In production none of this file is used: Coolify supplies the same variables
# to the container via docker-compose.yml.
#
# THIS IS THE WHOLE LIST. Everything the app used to take from the environment —
# the cron, the timezone, the model, the repo slug, the window — is a constant in
# src/lib/config.ts now; see the note at the top of that file. What is left here
# is credentials, one machine-specific remote, and one switch for a single run.

# Required — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Push credentials, resolved in this order: GIT_REMOTE, then GIT_TOKEN, then
# an SSH URL derived from the REPO_SLUG constant.
#
# GIT_REMOTE WINS. Setting a token while GIT_REMOTE still holds an SSH URL
# pushes over SSH and the token is never used — leave GIT_REMOTE empty unless
# you specifically need a non-GitHub remote.
#
# The SSH fallback only works if the key loaded on this machine belongs to an
# account with write access to that repo. It does not for imnaifu/files, so use
# a fine-grained PAT (contents:write) generated by the repo owner.
GIT_TOKEN=
GIT_REMOTE=

# Email subscriptions. Empty RESEND_API_KEY turns the whole feature off: no form
# on the page, no send after a run.
#
# https://resend.com/api-keys
RESEND_API_KEY=
# HMAC key for confirmation links — any long random string, e.g.
#   openssl rand -base64 32
# Rotating it invalidates unclicked confirmation links and nothing else;
# confirmed readers are contacts in Resend by then. Never needed to unsubscribe.
MAIL_SECRET=

# The password for /admin — the scoring dashboard. EMPTY MEANS THE PAGE DOES NOT
# EXIST: proxy.ts answers 404 rather than 401, so an unconfigured deployment does
# not advertise that there is something behind it to guess at.
#
#   openssl rand -base64 24
#
# There is no username — HTTP Basic sends a pair and only the password half is
# checked, so type anything in the first box. It is sent on every request, which
# is safe only because Traefik terminates TLS in front of this and there is no
# plaintext listener.
ADMIN_PASSWORD=

# =1 runs the whole pipeline but skips `git push` and the Bark notification.
# A switch for one invocation, which is why it is still here and the tuning
# knobs are not: `DRY_RUN=1 npm run once`.
# DRY_RUN=1
