{
  "minScore": 40,
  "summaryMinChars": 120,
  "summaryMaxChars": 300,
  "categories": [
    {
      "id": "ai",
      "name": "AI",
      "nameEn": "Artificial Intelligence",
      "accent": "#3B3563",
      "hint": "The article is ABOUT AI itself — models, agents, how they are built, what they can and cannot do, their effect on work. A piece that merely uses an AI tool to do something else belongs in the category of that something else.",
      "cardCount": 3
    },
    {
      "id": "tech",
      "name": "技术",
      "nameEn": "Engineering",
      "accent": "#2E7D6E",
      "hint": "Software and hardware craft that is NOT about AI: systems, debugging, security, privacy, open source, protocols, the web platform. A war story about a database bug goes here, not in AI.",
      "cardCount": 3
    },
    {
      "id": "business",
      "name": "商业",
      "nameEn": "Business & Product",
      "accent": "#EFA050",
      "hint": "Companies, strategy, markets, product decisions, platform policy, regulation of an industry. The subject is how an organisation behaves, not how a technology works.",
      "cardCount": 3
    },
    {
      "id": "investing",
      "name": "投资",
      "nameEn": "Investing",
      "accent": "#B08D2E",
      "hint": "Capital and markets as the subject: asset prices, valuation, portfolio reasoning, macro as it bears on returns. A company story is only here if it is argued from the investor's side.",
      "cardCount": 3
    },
    {
      "id": "culture",
      "name": "人文",
      "nameEn": "Society & Ideas",
      "accent": "#9E5C81",
      "hint": "LAST RESORT — use only when none of the categories above fits. Society, economics, history, science, design, creative work, writing, how people live and think. An essay is not filed here just because it is reflective: a reflective piece about models is still AI.",
      "cardCount": 3
    }
  ],
  "fallbackCategory": "culture",
